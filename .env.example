PORT=5005
MONGO_URI=mongodb://127.0.0.1:27017/butterbear
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
# ethereal provides a test inbox. Use smtp for actual delivery.
MAIL_TRANSPORT=ethereal
MAIL_FROM=Butterbear <bookings@butterbear.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Used only by npm run seed. Public registration always creates a normal user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Butterbear Admin
ADMIN_PHONE=0800000000
# Beanstalk has one nginx proxy in front of Express.
TRUST_PROXY=0
