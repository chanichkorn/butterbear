{
  "info": {
    "name": "Butterbear Final Presentation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 1 Core steps 01-12 through Runner or Newman, then show Class and Sequence Diagram slides, then run 2 Extra credits. Do not run the old collection for this presentation. Admin credentials and DEMO_EMAIL belong in an ignored local environment. This collection contains no real account credentials. A second user booking survives the first user deletion so admin steps operate on valid data. For real delivery choose a Gmail demonstration recipient that you control; the setup creates a unique plus-address alias. Extra credits leave their booking active while email delivery is inspected. Do not cancel it before emails arrive."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "URL",
      "value": "http://localhost:5005",
      "type": "string"
    },
    {
      "key": "DEMO_EMAIL",
      "value": "",
      "type": "string"
    },
    {
      "key": "EMAIL",
      "value": "",
      "type": "string"
    },
    {
      "key": "PASSWORD",
      "value": "",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "ADMIN_EMAIL",
      "value": "",
      "type": "string"
    },
    {
      "key": "ADMIN_PASSWORD",
      "value": "",
      "type": "string"
    },
    {
      "key": "CAMPGROUND_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "BOOKING_ID",
      "value": "",
      "type": "string"
    },
    {
