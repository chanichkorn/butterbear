      "value": "",
      "type": "string"
    },
    {
      "key": "EXTRA_BOOKING_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "CHECK_IN",
      "value": "",
      "type": "string"
    },
    {
      "key": "CHECK_OUT",
      "value": "",
      "type": "string"
    },
    {
      "key": "INVALID_CHECK_OUT",
