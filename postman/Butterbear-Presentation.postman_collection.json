    },
    {
      "key": "MAIL_POLL",
      "value": 0,
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 Core steps 01-12",
      "item": [
        {
          "name": "01a Registration validation rejects missing phone",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid registration\",\n  \"email\": \"{{EMAIL}}\",\n  \"password\": \"{{PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "const mailbox = pm.environment.get(\"DEMO_EMAIL\") || pm.collectionVariables.get(\"DEMO_EMAIL\");",
                  "const demoAddress = mailbox ? mailbox.replace(/^([^+@]+)(?:\\+[^@]*)?@gmail\\.com$/i, \"$1+butterbear-\" + stamp + \"@gmail.com\") : \"butterbear-\" + stamp + \"@example.test\";",
                  "pm.collectionVariables.set(\"EMAIL\", demoAddress);",
                  "pm.collectionVariables.set(\"PASSWORD\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"TOKEN\", \"\");",
                  "for (const key of [\"BOOKING_ID\", \"ADMIN_BOOKING_ID\", \"EXTRA_BOOKING_ID\"]) pm.collectionVariables.set(key, \"\");",
                  "const iso = offset => new Date(Date.now() + 7 * 3600000 + offset * 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set(\"CHECK_IN\", iso(1));",
                  "pm.collectionVariables.set(\"CHECK_OUT\", iso(4));",
                  "pm.collectionVariables.set(\"INVALID_CHECK_OUT\", iso(5));",
                  "const localHour = new Date(Date.now() + 7 * 3600000).getUTCHours();",
                  "const extraOffset = localHour < 9 ? 0 : 1;",
                  "pm.collectionVariables.set(\"EXTRA_CHECK_IN\", iso(extraOffset));",
                  "pm.collectionVariables.set(\"EXTRA_CHECK_OUT\", iso(extraOffset + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "01b Register ordinary user",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Butterbear Presenter\",\n  \"phone\": \"0800000000\",\n  \"email\": \"{{EMAIL}}\",\n  \"password\": \"{{PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"TOKEN\", pm.response.json().token);",
                  "pm.test(\"Registration creates a normal user\", () => pm.expect(pm.response.json().data.role).to.eql(\"user\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 User log-in",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{EMAIL}}\",\n  \"password\": \"{{PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"TOKEN\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 View campgrounds",
          "request": {
            "method": "GET",
            "url": "{{URL}}/api/v1/campgrounds",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "const camps = pm.response.json().data;",
                  "pm.test(\"Campground list has data\", () => pm.expect(camps.length).to.be.above(0));",
                  "if (camps.length) pm.collectionVariables.set(\"CAMPGROUND_ID\", camps[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04a Create valid three-night booking",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campground\": \"{{CAMPGROUND_ID}}\",\n  \"checkIn\": \"{{CHECK_IN}}\",\n  \"checkOut\": \"{{CHECK_OUT}}\",\n  \"specialRequest\": \"A quiet shaded pitch near the restroom.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"BOOKING_ID\", pm.response.json().data._id);",
                  "pm.test(\"Email work is queued\", () => pm.expect(pm.response.json().emailStatus).to.eql(\"queued\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04b Create second user booking for later admin steps",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/bookings",
            "header": [
              {
                "key": "Content-Type",
