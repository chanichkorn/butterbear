              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campground\": \"{{CAMPGROUND_ID}}\",\n  \"checkIn\": \"{{CHECK_IN}}\",\n  \"checkOut\": \"{{CHECK_OUT}}\",\n  \"specialRequest\": \"Booking retained for the admin demonstration.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"ADMIN_BOOKING_ID\", pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04c Reject a four-night booking",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campground\": \"{{CAMPGROUND_ID}}\",\n  \"checkIn\": \"{{CHECK_IN}}\",\n  \"checkOut\": \"{{INVALID_CHECK_OUT}}\",\n  \"specialRequest\": \"A quiet shaded pitch near the restroom.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Stay length condition is checked\", () => pm.expect(pm.response.json().message).to.include(\"1 and 3\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 View own bookings",
          "request": {
            "method": "GET",
            "url": "{{URL}}/api/v1/bookings",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Own booking is listed\", () => pm.expect(pm.response.json().data.map(b => b._id)).to.include(pm.collectionVariables.get(\"BOOKING_ID\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Edit own booking",
          "request": {
            "method": "PATCH",
            "url": "{{URL}}/api/v1/bookings/{{BOOKING_ID}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specialRequest\": \"User updated request for a shaded pitch.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Special request changed\", () => pm.expect(pm.response.json().data.specialRequest).to.eql(\"User updated request for a shaded pitch.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "07a Delete own booking",
          "request": {
            "method": "DELETE",
            "url": "{{URL}}/api/v1/bookings/{{BOOKING_ID}}",
            "header": []
