          ]
        }
      ]
    },
    {
      "name": "2 Extra credits step 15",
      "item": [
        {
          "name": "15a Log in as ordinary user",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{EMAIL}}\",\n  \"password\": \"{{PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"TOKEN\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "15b Add favorite campground",
          "request": {
            "method": "PUT",
            "url": "{{URL}}/api/v1/favorites/{{CAMPGROUND_ID}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "15c View favorite campground list",
          "request": {
            "method": "GET",
            "url": "{{URL}}/api/v1/favorites",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Chosen campground is a favorite\", () => pm.expect(pm.response.json().data.map(c => c._id)).to.include(pm.collectionVariables.get(\"CAMPGROUND_ID\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "15d Remove favorite campground",
          "request": {
            "method": "DELETE",
            "url": "{{URL}}/api/v1/favorites/{{CAMPGROUND_ID}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "15e Fetch external check-in weather",
          "request": {
            "method": "GET",
            "url": "{{URL}}/api/v1/campgrounds/{{CAMPGROUND_ID}}/weather?date={{EXTRA_CHECK_IN}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"External provider is Open-Meteo\", () => pm.expect(pm.response.json().data.source).to.eql(\"Open-Meteo\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "15f Book with special request and immediately due reminder",
          "request": {
            "method": "POST",
            "url": "{{URL}}/api/v1/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campground\": \"{{CAMPGROUND_ID}}\",\n  \"checkIn\": \"{{EXTRA_CHECK_IN}}\",\n  \"checkOut\": \"{{EXTRA_CHECK_OUT}}\",\n  \"specialRequest\": \"Please reserve a shaded pitch for the email demo.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"EXTRA_BOOKING_ID\", pm.response.json().data._id);",
                  "pm.test(\"Special request is saved\", () => pm.expect(pm.response.json().data.specialRequest).to.include(\"shaded pitch\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "15g Edit special request and queue update email",
          "request": {
            "method": "PATCH",
            "url": "{{URL}}/api/v1/bookings/{{EXTRA_BOOKING_ID}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specialRequest\": \"Please reserve a shaded pitch close to the restroom.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "15h Wait for confirmation, update and weather reminder",
          "request": {
            "method": "GET",
            "url": "{{URL}}/api/v1/bookings/{{EXTRA_BOOKING_ID}}/notifications",
            "header": []
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"MAIL_POLL\")) pm.collectionVariables.set(\"MAIL_POLL\", 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                  "const jobs = pm.response.json().data || [];",
                  "const latestRevision = Math.max(0, ...jobs.map(j => j.revision));",
                  "const required = [jobs.find(j => j.type === \"confirmation\"), jobs.find(j => j.type === \"update\" && j.revision === latestRevision), jobs.find(j => j.type === \"reminder\" && j.revision === latestRevision)];",
                  "const ready = required.every(j => j && [\"sent\", \"preview\"].includes(j.status));",
                  "const poll = Number(pm.collectionVariables.get(\"MAIL_POLL\") || 0);",
                  "if (pm.response.code === 200 && !ready && poll < 18 && !jobs.some(j => j.status === \"failed\")) {",
                  "  pm.collectionVariables.set(\"MAIL_POLL\", poll + 1);",
                  "  console.log(\"Waiting for email worker, poll \" + (poll + 1));",
                  "  setTimeout(() => pm.execution.setNextRequest(pm.info.requestName), 3000);",
                  "} else {",
                  "  pm.collectionVariables.set(\"MAIL_POLL\", 0);",
                  "  pm.test(\"All three email types completed\", () => pm.expect(ready).to.eql(true));",
                  "  console.log(\"Email delivery statuses\", required.map(j => ({ type: j?.type, status: j?.status })));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}