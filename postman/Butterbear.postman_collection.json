            "method": "GET",
            "header": [],
            "url": "{{URL}}/api/v1/campgrounds"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const campgrounds = pm.response.json().data;",
                  "pm.test(\"Seeded campgrounds exist\", () => pm.expect(campgrounds.length).to.be.above(0));",
                  "if (campgrounds.length) pm.collectionVariables.set(\"CAMPGROUND_ID\", campgrounds[0]._id);"
                ]
              }
            }
          ]
        },
