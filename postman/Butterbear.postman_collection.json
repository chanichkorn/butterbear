          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"BOOKING_ID\", pm.response.json().data._id);",
                  "pm.test(\"Confirmation and reminder queued\", () => pm.expect(pm.response.json().emailStatus).to.eql(\"queued\"));"
                ]
