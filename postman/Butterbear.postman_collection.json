            "url": "{{URL}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campground\": \"{{CAMPGROUND_ID}}\",\n  \"checkIn\": \"{{CHECK_IN}}\",\n  \"checkOut\": \"{{CHECK_OUT}}\",\n  \"specialRequest\": \"A quiet pitch near the restroom, please.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
